PRODUCT_BUNDLE_IDENTIFIER = io.github.dejitarunoseireinoapuri.kioku
IPHONEOS_DEPLOYMENT_TARGET = 16.0
SWIFT_VERSION = 5.0
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
FRAMEWORK_SEARCH_PATHS = $(inherited) $(SRCROOT)/../shared/build/xcode-frameworks/$(CONFIGURATION)/$(SDK_NAME)
OTHER_LDFLAGS = $(inherited) -framework KiokuShared
ENABLE_USER_SCRIPT_SANDBOXING = NO
CODE_SIGN_STYLE = Automatic
INFOPLIST_FILE = iosApp/Info.plist
TARGETED_DEVICE_FAMILY = 1,2
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
GOOGLE_REVERSED_CLIENT_ID =
APP_ATTEST_ENVIRONMENT = production
CODE_SIGN_ENTITLEMENTS = iosApp/Kioku.entitlements
#include "Firebase.xcconfig"
#include? "Firebase.local.xcconfig"
