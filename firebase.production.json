{
  "functions": [
    {
      "source": "backend",
      "codebase": "kioku",
      "runtime": "nodejs22",
      "predeploy": [
        "node tooling/backend.mjs build",
        "node tooling/backend.mjs format:check"
      ],
      "ignore": [
        "node_modules",
        "test",
        "lib/test",
        "src/setup",
        "lib/src/setup",
        ".env*",
        "*.local",
        "*-debug.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "location": "europe-west1"
  }
}
